rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── 마스터 권한 (jaduck9@gmail.com) ────────────────────────────────────
    function isMaster() {
      return request.auth != null
          && request.auth.uid == 'pNBOyNLJjVdgUYuGNwCWz8s3x0z1';
    }

    // ── videos/ 폴더 (동영상) ──────────────────────────────────────────────
    match /videos/{userId}/{filename} {
      allow read: if true;
      allow create: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 500 * 1024 * 1024; // 500MB 제한
      allow delete: if isMaster()
                   || (request.auth != null && request.auth.uid == userId);
      allow update: if false;
    }

    // ── photos/ 폴더 (사진) ────────────────────────────────────────────────
    match /photos/{userId}/{filename} {
      allow read: if true;
      allow create: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024; // 50MB 제한
      allow delete: if isMaster()
                   || (request.auth != null && request.auth.uid == userId);
      allow update: if false;
    }

    // ── events/ 폴더 (이벤트 포스터) ───────────────────────────────────────
    // Storage 규칙은 Firestore 역할(eventRole)을 못 읽으므로 로그인 사용자면
    // 업로드 허용(20MB). 실제 이벤트 등록은 Firestore 규칙에서 역할로 인가하므로
    // 권한 없는 사용자가 올린 포스터는 이벤트에 연결되지 않는 고아 파일일 뿐.
    match /events/{filename} {
      allow read: if true;
      allow create: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024;
      allow delete: if request.auth != null;
      allow update: if false;
    }

    // ── thumbnails/ 폴더 (썸네일) ──────────────────────────────────────────
    match /thumbnails/{userId}/{filename} {
      allow read: if true;
      allow create: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024; // 10MB 제한
      allow delete: if isMaster()
                   || (request.auth != null && request.auth.uid == userId);
      allow update: if false;
    }

    // ── avatars/ 폴더 (프로필 사진) ────────────────────────────────────────
    // 파일명이 "{uid}.jpg" 라 경로 세그먼트가 아닌 파일명으로 소유자 검증.
    // 사진 변경 = 같은 경로 덮어쓰기(update) 이므로 create/update 모두 허용.
    match /avatars/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.jpg'
                   && (request.resource == null
                       || request.resource.size < 10 * 1024 * 1024); // 10MB
    }
  }
}

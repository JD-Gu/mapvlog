rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── 마스터 권한 (jaduck9@gmail.com) ────────────────────────────────────
    function isMaster() {
      return request.auth != null
          && request.auth.uid == 'pNBOyNLJjVdgUYuGNwCWz8s3x0z1';
    }

    // ── videos/ 폴더 (동영상) ──────────────────────────────────────────────
    match /videos/{userId}/{filename} {
      allow read: if true;
      allow create: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 500 * 1024 * 1024; // 500MB 제한
      allow delete: if isMaster()
                   || (request.auth != null && request.auth.uid == userId);
      allow update: if false;
    }

    // ── photos/ 폴더 (사진) ────────────────────────────────────────────────
    match /photos/{userId}/{filename} {
      allow read: if true;
      allow create: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024; // 50MB 제한
      allow delete: if isMaster()
                   || (request.auth != null && request.auth.uid == userId);
      allow update: if false;
    }

    // ── thumbnails/ 폴더 (썸네일) ──────────────────────────────────────────
    match /thumbnails/{userId}/{filename} {
      allow read: if true;
      allow create: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024; // 10MB 제한
      allow delete: if isMaster()
                   || (request.auth != null && request.auth.uid == userId);
      allow update: if false;
    }
  }
}

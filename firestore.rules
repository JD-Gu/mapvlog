rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 부트스트랩 오너(앱 제작자) — uid 고정. 항상 슈퍼, 강등 불가 ──────────
    function isMaster() {
      return request.auth != null
          && request.auth.uid == 'pNBOyNLJjVdgUYuGNwCWz8s3x0z1';
    }

    // ── 이벤트 마스터(Event Master) — users 문서 eventRole/eventCategories ──
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // 슈퍼 마스터 = 부트스트랩 오너 또는 본인 문서 eventRole == 'super'.
    // (본인 doc 을 참조하므로 스스로 super 를 부여하는 escalation 은 아래 users
    //  update 규칙에서 role 키 변경을 isSuperMaster 로만 허용해 차단됨)
    function isSuperMaster() {
      return isMaster()
          || (request.auth != null && userDoc().eventRole == 'super');
    }
    function isEventMasterFor(cat) {
      return request.auth != null
          && userDoc().eventRole == 'event'
          && (userDoc().eventCategories.hasAny(['all'])
              || userDoc().eventCategories.hasAny([cat]));
    }

    // ── vlogs 컬렉션 ────────────────────────────────────────────────────────
    match /vlogs/{vlogId} {
      // 읽기는 로그인된 사용자에게 허용 (visibility 는 클라이언트에서 enforce).
      // Firestore 룰로 visibility 를 막으면 whereIn 쿼리가 private 후보를 포함할 때
      // 전체 쿼리가 permission_denied 로 실패 → 피드가 비어버림.
      // 실제 visibility 필터링은 FirestoreService.watchFriendsVlogs 에서 처리.
      allow read: if request.auth != null;

      // 로그인 사용자만 새 브이로그 생성
      allow create: if request.auth != null;

      // 마스터 또는 본인 브이로그만 수정·삭제
      allow update, delete: if isMaster()
                            || (request.auth != null
                                && request.auth.uid == resource.data.authorId);

      // ── likes 서브컬렉션 (vlog 좋아요) ─────────────────────────────────
      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if request.auth != null
                              && request.auth.uid == userId;
      }

      // ── reactions 서브컬렉션 (Slack 스타일 이모지 리액션) ──────────────
      // docId = {userId}_{emoji} 형태 — 한 사용자가 여러 이모지로 리액션 가능
      match /reactions/{reactionId} {
        allow read: if true;
        allow create, delete: if request.auth != null
                              && request.auth.uid == request.resource.data.userId
                              || (request.auth != null
                                  && resource != null
                                  && request.auth.uid == resource.data.userId);
      }

      // ── comments 서브컬렉션 ───────────────────────────────────────────
      match /comments/{commentId} {
        allow read: if true;

        // 작성자 본인만 생성
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.authorId;

        // 작성자 본인 또는 vlog 등록자 또는 마스터 삭제
        allow delete: if isMaster()
                      || (request.auth != null
                          && (request.auth.uid == resource.data.authorId
                              || request.auth.uid == get(/databases/$(database)/documents/vlogs/$(vlogId)).data.authorId));

        // likeCount 필드만 변경하는 update 허용 (좋아요 토글)
        allow update: if request.auth != null
                      && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['likeCount']);

        // 댓글 좋아요 서브컬렉션
        match /likes/{userId} {
          allow read: if true;
          allow create, delete: if request.auth != null
                                && request.auth.uid == userId;
        }
      }
    }

    // ── saves 컬렉션그룹 (즐겨찾기 북마크) ────────────────────────────────────
    // ⚠️ collectionGroup('saves').where('uid'==me) 쿼리를 허용하려면 경로 한정
    //    (/vlogs/{id}/saves/...) 규칙으로는 안 되고, 반드시 재귀 와일드카드
    //    (/{path=**}/saves/...) 규칙이어야 한다. 인가는 쿼리가 거는 uid 필드 기준.
    match /{path=**}/saves/{saveId} {
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.uid;
    }

    // ── events 컬렉션 (라이브 이벤트 맵) ──────────────────────────────────────
    match /events/{eventId} {
      // 공개 — 누구나 읽기 (이벤트는 공개 정보)
      allow read: if true;
      // Super Master 전체 / Event Master 는 담당 카테고리만 등록·삭제
      allow create: if isMaster()
                    || isEventMasterFor(request.resource.data.category);
      allow delete: if isMaster()
                    || isEventMasterFor(resource.data.category);
      // 수정: Super 전체 / Event Master 는 (구·신 카테고리 모두 담당일 때) /
      //       일반 사용자는 카운트 필드만 (좋아요·저장·조회수)
      allow update: if isMaster()
                    || (isEventMasterFor(resource.data.category)
                        && isEventMasterFor(request.resource.data.category))
                    || (request.auth != null
                        && request.resource.data.diff(resource.data)
                           .affectedKeys()
                           .hasOnly(['likeCount', 'saveCount', 'viewCount',
                                     'commentCount']));

      // 좋아요 서브컬렉션 (본인 doc만 생성/삭제)
      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if request.auth != null
                              && request.auth.uid == userId;
      }
      // 저장(saves)은 최상위 재귀 /{path=**}/saves 규칙으로 인가 (uid 필드 기준)

      // ── 이벤트 댓글 ───────────────────────────────────────────────────
      match /comments/{commentId} {
        allow read: if true;
        // 작성자 본인만 생성
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.authorId;
        // 작성자 본인 / 이벤트 등록자 / 마스터 삭제
        allow delete: if isMaster()
                      || (request.auth != null
                          && (request.auth.uid == resource.data.authorId
                              || request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.createdBy));
        // likeCount 토글만 update 허용
        allow update: if request.auth != null
                      && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['likeCount']);
        match /likes/{userId} {
          allow read: if true;
          allow create, delete: if request.auth != null
                                && request.auth.uid == userId;
        }
      }
    }

    // ── config 컬렉션 (앱 설정 — 신규 버전 정보 등) ──────────────────────────
    match /config/{configId} {
      // 모든 사용자(익명 포함) 읽기 — 앱 시작 시 버전 체크
      allow read: if true;
      // 마스터만 쓰기 가능
      allow write: if isMaster();
    }

    // ── users 컬렉션 ────────────────────────────────────────────────────────
    match /users/{userId} {
      // 로그인 사용자만 읽기 — 익명 대량 위치 스크래핑 차단.
      // (앱은 Google 로그인 필수, vlog는 작성자명/사진을 비정규화 저장하므로
      //  로그아웃 딥링크에도 user 문서 읽기가 필요 없음)
      // ⚠️ 인증 사용자 간 위치 노출은 2단계(liveLocations 분리)에서 차단 예정.
      allow read: if request.auth != null;

      // 슈퍼 마스터 또는 본인 프로필만 생성·수정.
      // ⚠️ eventRole/eventCategories(역할)는 Super Master 만 변경 가능 —
      //    일반 사용자가 자기 doc 에 스스로 역할을 부여하지 못하게 차단.
      allow create: if isSuperMaster()
                    || (request.auth != null
                        && request.auth.uid == userId
                        && !request.resource.data.keys()
                            .hasAny(['eventRole', 'eventCategories']));
      allow update: if isSuperMaster()
                    || (request.auth != null
                        && request.auth.uid == userId
                        && !request.resource.data.diff(resource.data)
                            .affectedKeys()
                            .hasAny(['eventRole', 'eventCategories']));

      // 문서 삭제는 부트스트랩 오너만 (일반·슈퍼 모두 불가)
      allow delete: if isMaster();

      // ── friends 서브컬렉션 (양쪽 관계 doc 페어) ──────────────────────────
      // users/{me}/friends/{friend}  ← 내가 본 친구 관계
      match /friends/{friendUid} {
        // 누구나 읽기 (친구 목록·검색·관계 확인용)
        allow read: if true;

        // 본인 doc 컨테이너인 경우 본인이 작성 (sendRequest의 내쪽 doc)
        // 다른 사람이 본인 doc에 incoming 요청을 쓰는 케이스도 허용
        allow create, update: if request.auth != null
                              && (request.auth.uid == userId
                                  || request.auth.uid == friendUid);

        // 본인 또는 상대 둘 다 삭제 가능 (친구 해제)
        allow delete: if request.auth != null
                      && (request.auth.uid == userId
                          || request.auth.uid == friendUid);
      }

      // ── friendGroups 서브컬렉션 (커스텀 그룹 — 본인만 read/write) ──────
      match /friendGroups/{groupId} {
        allow read, create, update, delete: if request.auth != null
                                            && request.auth.uid == userId;
      }

      // ── fcmTokens 서브컬렉션 (푸시 토큰 — 본인만 read/write) ────────────
      // Cloud Functions(Admin SDK)는 규칙을 우회하므로 발송 시 자유롭게 읽음
      match /fcmTokens/{token} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // ── pings 서브컬렉션 (호출 알림) ─────────────────────────────────────
      // users/{me}/pings/{pingId}  ← 내게 온 ping
      match /pings/{pingId} {
        // 본인 ping만 읽기 (수신함 사생활)
        allow read: if request.auth != null
                    && request.auth.uid == userId;

        // 누구나 다른 사람에게 ping 보낼 수 있음 (fromUid 본인 검증)
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.fromUid;

        // 본인만 삭제 (확인 후 dismiss)
        allow delete: if request.auth != null
                      && request.auth.uid == userId;
      }
    }

    // ── liveLocations 컬렉션 (실시간 좌표 — 친구만 열람) ──────────────────────
    // 민감한 GPS 좌표를 public-read인 users 문서에서 분리.
    // 본인 또는 visibleTo(수락된 친구) 목록에 포함된 사용자만 읽기 가능.
    // 클라이언트는 where('visibleTo', arrayContains: 내uid) 로 친구 것만 조회.
    match /liveLocations/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid
                      || request.auth.uid in resource.data.visibleTo);
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
